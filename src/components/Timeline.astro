---
import { getCollection } from 'astro:content';
import { education } from '../data/site';
import { currentYm, dateRange, duration, href, monthIndex } from '../lib/utils';

const roles = (await getCollection('experience')).sort((a, b) => monthIndex(a.data.start) - monthIndex(b.data.start));

type Row = { key: string; title: string; sub: string; start: string; end: string | null; kind: 'analytics' | 'operations' | 'study'; link?: string };

const rows: Row[] = roles.map((r) => ({
  key: r.id,
  title: r.data.employer,
  sub: r.data.role,
  start: r.data.start,
  end: r.data.end,
  kind: r.data.track,
  link: href(`/experience/${r.id}/`),
}));

// Study periods that fall inside the working timeline explain the gaps between roles.
const firstStart = Math.min(...rows.map((r) => monthIndex(r.start)));
for (const ed of education) {
  if (monthIndex(ed.start) >= firstStart) {
    rows.push({ key: ed.school, title: ed.school, sub: 'Graduate certificate', start: ed.start, end: ed.end, kind: 'study' });
  }
}
rows.sort((a, b) => monthIndex(a.start) - monthIndex(b.start));

const now = currentYm();
const firstYear = Math.floor(firstStart / 12);
const lastYear = Math.floor(monthIndex(now) / 12);
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i);
const origin = firstYear * 12;
const span = years.length * 12;
const pos = (r: Row) => {
  const s = monthIndex(r.start) - origin;
  const e = monthIndex(r.end ?? now) - origin + 1;
  return `left:${((s / span) * 100).toFixed(3)}%;width:${(((e - s) / span) * 100).toFixed(3)}%`;
};
---

<div class="timeline" style={`--years:${years.length}`}>
  <div class="axis" aria-hidden="true">
    <span></span>
    <div class="years">
      {years.map((y) => <span>{y}</span>)}
    </div>
  </div>
  <ol>
    {
      rows.map((r) => {
        const inner = (
          <>
            <span class="who">
              <span class="title">{r.title}</span>
              <span class="sub">{r.sub}</span>
              <span class="when">
                {dateRange(r.start, r.end)}, {duration(r.start, r.end)}
              </span>
            </span>
            <span class="track">
              <span class={`bar bar-${r.kind}`} style={pos(r)} />
            </span>
          </>
        );
        return (
          <li>
            {r.link ? (
              <a class="row" href={r.link}>
                {inner}
              </a>
            ) : (
              <div class="row">{inner}</div>
            )}
          </li>
        );
      })
    }
  </ol>
  <ul class="legend">
    <li><span class="swatch bar-analytics"></span>Data and analytics role</li>
    <li><span class="swatch bar-operations"></span>Operations role</li>
    <li><span class="swatch bar-study"></span>Study</li>
  </ul>
</div>

<style>
  .timeline { --label: 17rem; }
  ol { list-style: none; border-top: 1px solid var(--line); }
  .axis, .row { display: grid; grid-template-columns: var(--label) 1fr; gap: var(--space-4); align-items: center; }
  .years { display: grid; grid-template-columns: repeat(var(--years), 1fr); font-size: 0.8125rem; color: var(--ink-3); padding-bottom: var(--space-2); font-variant-numeric: tabular-nums; }
  .row { padding-block: 0.7rem; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  a.row:hover .title, a.row:focus-visible .title { color: var(--accent); text-decoration: underline; text-underline-offset: 0.18em; }
  a.row:hover .bar { outline: 2px solid var(--ink); outline-offset: 2px; }
  .who { display: grid; line-height: 1.3; }
  .title { font-weight: 650; }
  .sub { font-size: var(--step--1); color: var(--ink-2); }
  .when { font-size: 0.8125rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .track {
    position: relative;
    height: 1.5rem;
    background-image: linear-gradient(to right, var(--line) 1px, transparent 1px);
    background-size: calc(100% / var(--years)) 100%;
  }
  .bar { position: absolute; top: 0.25rem; bottom: 0.25rem; min-width: 6px; border-radius: 3px; }
  .bar-analytics { background: var(--accent); }
  .bar-operations { background: var(--surface); border: 2px solid var(--ink); }
  .bar-study { background: repeating-linear-gradient(135deg, var(--ink-3) 0 2px, transparent 2px 6px); border: 1px solid var(--ink-3); }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-top: var(--space-4); font-size: 0.8125rem; color: var(--ink-2); }
  .legend li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .swatch { width: 1.4rem; height: 0.7rem; border-radius: 2px; display: inline-block; }

  @media (max-width: 47.99rem) {
    .axis { display: none; }
    .row { grid-template-columns: 1fr; gap: var(--space-2); }
    .track { height: 1.1rem; }
    .bar { top: 0.15rem; bottom: 0.15rem; }
  }
</style>

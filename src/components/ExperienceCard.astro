---
import type { CollectionEntry } from 'astro:content';
import StatusTag from './StatusTag.astro';
import { dateRange, href } from '../lib/utils';

interface Props {
  entry: CollectionEntry<'experience'>;
  caseStudies: number;
}
const { entry, caseStudies } = Astro.props;
const e = entry.data;
const supported = e.achievements.find((a) => a.status === 'verified' || a.status === 'reported');
---

<article class="exp card" data-card data-domain={e.domains.join('|')}>
  <header>
    <div>
      <h3><a href={href(`/experience/${entry.id}/`)}>{e.employer}</a></h3>
      {e.employerNote && <p class="muted small">{e.employerNote}</p>}
    </div>
    <p class="dates">{dateRange(e.start, e.end)}</p>
  </header>
  <p class="role">
    {e.role}{e.account && `, ${e.account}`}
  </p>
  <p class="muted small">
    {e.industry}{e.industryNeedsConfirmation && ' (to confirm)'}, {e.location}
  </p>
  <p class="summary">{e.summary}</p>
  {
    supported && (
      <p class="achievement">
        <strong>
          {supported.value} {supported.unit}
        </strong>
        <span>{supported.name.toLowerCase()}</span>
        <StatusTag status={supported.status} />
      </p>
    )
  }
  {
    e.tools.length > 0 && (
      <ul class="tag-list" aria-label="Technologies">
        {e.tools.map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
    )
  }
  <footer>
    <span class="count">{caseStudies === 0 ? 'No case studies yet' : `${caseStudies} case ${caseStudies === 1 ? 'study' : 'studies'}`}</span>
    <span class="go" aria-hidden="true">View role</span>
  </footer>
</article>

<style>
  .exp { position: relative; padding: var(--space-5); display: grid; gap: var(--space-3); align-content: start; transition: border-color 0.15s; }
  .exp:hover, .exp:focus-within { border-color: var(--accent); }
  header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-4); align-items: baseline; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .dates { font-size: var(--step--1); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .role { font-weight: 600; }
  .summary { font-family: var(--font-prose); font-size: 1.0625rem; line-height: 1.55; }
  .achievement { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.6rem; font-size: 0.9375rem; padding: var(--space-3); background: var(--accent-soft); border-radius: var(--radius-sm); }
  footer { display: flex; justify-content: space-between; gap: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--line); font-size: var(--step--1); margin-top: auto; }
  .count { color: var(--ink-2); }
  .go { font-weight: 600; color: var(--accent); text-decoration: underline; text-underline-offset: 0.18em; }
</style>

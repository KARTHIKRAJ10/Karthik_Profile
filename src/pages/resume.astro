---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { capabilities, education, site } from '../data/site';
import { byStartDesc, dateRange, href } from '../lib/utils';
import { resumeUrl } from '../lib/resume';

const experience = (await getCollection('experience')).sort(byStartDesc);
const groups = [
  { title: 'Data and analytics experience', items: experience.filter((e) => e.data.track === 'analytics') },
  { title: 'Operations experience', items: experience.filter((e) => e.data.track === 'operations') },
];
const resume = resumeUrl();
---

<BaseLayout title="Résumé" description={`Résumé of ${site.name}: experience, skills and education.`}>
  <div class="wrap page-head">
    <h1>Résumé</h1>
    <div class="btn-row actions no-print">
      {
        resume && (
          <a class="btn btn-primary" href={resume} download>
            Download résumé (PDF)
          </a>
        )
      }
      <button type="button" class="btn" data-print>Print or save as PDF</button>
    </div>
  </div>

  <div class="wrap sheet">
    <header>
      <p class="r-name">{site.name}</p>
      <p class="muted">
        {site.location}
        {site.email && <>, <a href={`mailto:${site.email}`}>{site.email}</a></>}
        {site.linkedin && <>, <a href={site.linkedin}>{site.linkedin.replace('https://www.', '')}</a></>}
      </p>
    </header>

    <section>
      <h2>Summary</h2>
      <p class="prose">{site.intro}</p>
    </section>

    <section>
      <h2>Technical skills</h2>
      <dl class="skills">
        {
          capabilities.map((c) => (
            <div>
              <dt>{c.domain}</dt>
              <dd>{c.skills.map((s) => s.label).join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      groups.map((g) => (
        <section>
          <h2>{g.title}</h2>
          {g.items.map((e) => (
            <div class="job">
              <div class="job-head">
                <h3>
                  <a href={href(`/experience/${e.id}/`)}>{e.data.employer}</a>
                  {e.data.employerNote && <span class="note"> {e.data.employerNote}</span>}
                </h3>
                <p class="dates">{dateRange(e.data.start, e.data.end)}</p>
              </div>
              <p class="role">
                {e.data.role}
                {e.data.account && `, ${e.data.account}`}, {e.data.location}
              </p>
              <ul>
                {e.data.responsibilities.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }

    <section>
      <h2>Education</h2>
      {
        education.map((ed) => (
          <div class="job">
            <div class="job-head">
              <h3>{ed.credential}</h3>
              <p class="dates">{ed.dates}</p>
            </div>
            <p class="role">
              {ed.school}, {ed.place}
            </p>
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .actions { margin-top: var(--space-5); }
  .sheet { max-width: 52rem; display: grid; gap: var(--space-6); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.25rem, 4vw, 3rem); }
  .r-name { font-size: var(--step-3); font-weight: 700; letter-spacing: -0.02em; }
  section { display: grid; gap: var(--space-4); }
  h2 { font-size: var(--step-1); padding-bottom: var(--space-2); border-bottom: 2px solid var(--ink); }
  .skills { margin: 0; display: grid; gap: var(--space-2); }
  .skills div { display: grid; gap: 0 var(--space-4); }
  .skills dt { font-weight: 650; }
  .skills dd { margin: 0; color: var(--ink-2); }
  .job { display: grid; gap: var(--space-1); }
  .job + .job { margin-top: var(--space-3); }
  .job-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 var(--space-4); align-items: baseline; }
  .job h3 { font-size: var(--step-1); }
  .job h3 a { color: var(--ink); }
  .note { font-weight: 400; font-size: var(--step--1); color: var(--ink-2); letter-spacing: 0; }
  .dates { font-size: var(--step--1); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .role { color: var(--ink-2); }
  .job ul { padding-left: 1.1rem; margin-top: var(--space-2); font-family: var(--font-prose); line-height: 1.55; }
  .job li + li { margin-top: 0.3rem; }
  @media (min-width: 44rem) { .skills div { grid-template-columns: 15rem 1fr; } }
  @media print {
    .sheet { border: 0; padding: 0; }
    .page-head { display: none; }
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
